APP_NAME={{ app_name }}
APP_ENV=production
APP_DEBUG=false

JWT_SECRET_KEY={{ jwt_secret_key }}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

ADMIN_REGISTRATION_CODE={{ admin_registration_code }}

POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}

REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_DB={{ redis_db }}
REDIS_URL=redis://{{ redis_host }}:{{ redis_port }}/{{ redis_db }}
REDIS_KEY_PREFIX=hackathon

AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
CACHE_TTL_SECONDS=60

KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_CLIENT_ID=hackathon
KAFKA_EVENTS_CONSUMER_GROUP=hackathon.events

KAFKA_EVENTS_TOPIC=hackathon.events.v1
KAFKA_EVENTS_DLQ_TOPIC=hackathon.events.dlq.v1
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_SECONDS=1.0

OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1.0

TELEGRAM_API_TIMEOUT_SECONDS=10.0