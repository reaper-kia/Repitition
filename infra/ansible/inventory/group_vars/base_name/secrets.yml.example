# Скопируй в secrets.yml и подставь реальные значения.
# secrets.yml добавлен в .gitignore и не должен попадать в репозиторий.
#
# Сгенерировать секрет:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
postgres_password: replace-me
jwt_secret_key: replace-me
admin_registration_code: replace-me
